{
  "name": "dsh-process-guard",
  "version": "0.2.1",
  "description": "DeepSeek Harness bundle that refuses shell commands terminating browsers or the harness host by image name, wildcard, process group, or unfiltered enumeration.",
  "author": "CetOeil",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "examples",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "guard",
    "safety",
    "process",
    "windows",
    "chrome"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.0-rc.6 || >=0.1.5-rc.1"
  },
  "scripts": {
    "check": "npm run verify && npm run verify:market && npm test && npm run verify:package",
    "verify": "node scripts/check-bundle.mjs",
    "verify:market": "node scripts/check-market.mjs",
    "verify:package": "node scripts/check-package.mjs",
    "test": "node --test test/matcher.test.js test/plugin.test.js",
    "test:spec": "node --test --test-reporter=spec test/matcher.test.js test/plugin.test.js",
    "test:no-isolation": "node --test --test-isolation=none --test-reporter=spec test/matcher.test.js test/plugin.test.js",
    "prepublishOnly": "npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CetOeil/dsh-process-guard.git"
  },
  "bugs": {
    "url": "https://github.com/CetOeil/dsh-process-guard/issues"
  },
  "homepage": "https://github.com/CetOeil/dsh-process-guard#readme",
  "publishConfig": {
    "access": "public"
  }
}
